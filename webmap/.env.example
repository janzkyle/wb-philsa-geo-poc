# Copy to `.env` to override defaults (all optional for local dev).
# These are Vite BUILD-TIME config values, not secrets - the chat server's
# OPENROUTER_API_KEY lives in the repo-root .env (see AGENTS.md), never here.

# STAC catalog API (collection/item discovery, region search)
VITE_STAC_API=http://localhost:8082
# TiTiler dynamic raster tiler (compose.viz.yml)
VITE_TITILER=http://localhost:8083
# STAC Browser explorer UI - target of the (i) dataset-details links
VITE_STAC_BROWSER=http://localhost:8080
# Public R2 base serving admin-boundary PMTiles + per-date MosaicJSON
VITE_R2_PUBLIC_BASE=https://pub-17ab60a2ca7142a48ae8e2685cd853f7.r2.dev
# Chat endpoint. Default "/api/chat" is proxied to :8087 by Vite in dev.
# PRODUCTION BUILDS MUST OVERRIDE THIS: the deployed webmap is a static site, so
# the relative default resolves to the static host, which returns an empty 200 -
# the chat then just does nothing, with no error to explain why. Point it at the
# deployed chat Worker, e.g.
#   VITE_CHAT_API=https://philsa-chat.philsa.workers.dev/api/chat
# render.yaml already sets this for the philsa-webmap service.
VITE_CHAT_API=/api/chat
