# PhilSA POC — LOCAL database environment.
# Copy to `local.env` (gitignored) — `cp local.env.example local.env`.
#
# Points at the Dockerized pgSTAC from stac-fastapi-pgstac/compose.yml, which
# maps Postgres to host port 5439 with the committed dev credentials. Nothing
# here is a real secret, so you can use it as-is for local work.

PHILSA_ENV=local

# --- Postgres / pgSTAC (local Docker: stac-fastapi-pgstac/compose.yml) ---
PGHOST=localhost
PGPORT=5439
PGUSER=username
PGPASSWORD=password
PGDATABASE=postgis
# Convenience DSN for psql / pypgstac. Keep in sync with the PG* vars above.
DATABASE_URL=postgresql://username:password@localhost:5439/postgis

# --- STAC API (local compose, transactions extension ON for ingest) ---
STAC_API=http://localhost:8082
