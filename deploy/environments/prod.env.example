# PhilSA POC — PROD database environment (Neon).
# Copy to `prod.env` (gitignored) — `cp prod.env.example prod.env` — and fill in
# from your Neon project. See ../DEPLOYMENT.md for where each value comes from.
#
# Use the DIRECT connection string (Neon dashboard ▸ Connect ▸ "Direct
# connection", NOT the pooled `-pooler` host) so `pypgstac migrate` gets a real
# session. PostGIS installs into `public`, so pgSTAC finds it with no search_path
# tweaks.

PHILSA_ENV=prod

# --- Neon Postgres (Dashboard ▸ Connect ▸ Direct connection) ---
# Host looks like: ep-cool-name-12345678.ap-southeast-1.aws.neon.tech
PGHOST=<your-neon-endpoint>.aws.neon.tech
PGPORT=5432
PGUSER=<your-neon-role>            # often `neondb_owner`
PGPASSWORD=<your-neon-password>
PGDATABASE=neondb                  # Neon's default database name
DATABASE_URL=postgresql://<user>:<password>@<your-neon-endpoint>.aws.neon.tech:5432/neondb?sslmode=require

# --- Deployed STAC API (Render) — fill in after the API service is live ---
STAC_API=https://wb-philsa-stac-api.onrender.com
