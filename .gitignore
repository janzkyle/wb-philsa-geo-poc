# secrets / local env
.env
.env.*
*.env
# …but DO track the committed templates (no secrets in them)
!.env.example
!**/.env.example

# deployment: real per-environment env files hold secrets; templates stay tracked
deploy/environments/*.env
!deploy/environments/*.env.example
# wrangler's local-secret file (`wrangler dev` reads it); real secrets in prod
# go through `wrangler secret put`, never a tracked file
.dev.vars
.dev.vars.*
# local venv the deploy scripts build for pypgstac
deploy/.venv/

# generated PH admin boundary GeoParquet (rebuild via the ph-admin-geoparquet skill)
phl_adm*.parquet

# local geodatabase download cache
*.gdb.zip

# downloaded raw Sentinel scenes from CopPhil (download_copphil_eodata.py)
/eodata/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Wrangler local state/cache (Cloudflare Workers dev)
.wrangler/
