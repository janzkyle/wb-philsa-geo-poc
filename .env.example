# PhilSA POC — single .env template. Copy to `.env` (gitignored) and fill in.
#
# One file holds every backend secret/config: all pipeline scripts and
# compose.viz.yml auto-load the repo-root `.env`. Override the path with ENV_FILE=…
# The webmap is separate — it reads its own `webmap/.env` (Vite VITE_* vars).

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_BUCKET=your-bucket
R2_ACCOUNT_ID=your-cloudflare-account-id
# Public base URL (r2.dev subdomain or custom domain) for printed/asset hrefs.
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
# R2 API token (Object Read & Write), used as S3 SigV4 creds.
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# NOTE: R2_PREFIX is ignored — each script hardcodes its own <tier>/<dataset> prefix.

# --- CopPhil / EODATA (Keycloak password grant) ---
COPPHIL_USERNAME=your-copphil-username
COPPHIL_PASSWORD=your-copphil-password
# COPPHIL_CLIENT_ID=copphil-public   # optional, this is the default

# --- OpenRouter (webmap AI chat + dashboard genai-proxy) ---
# Read by webmap/server/chat.mjs (`npm run chat`) and dashboard/genai-proxy —
# both auto-load this file. A deployed chat service would get this as a
# platform env var instead (like the `sync: false` secrets in render.yaml).
OPENROUTER_API_KEY=your-openrouter-api-key
# GENAI_MODEL=qwen/qwen3-coder:free   # optional model override (chat server)

# --- Dagster orchestration (pipelines/orchestration/) ---
# Run/event storage in a `dagster` database on the pgSTAC Postgres
# (stac-fastapi-pgstac/compose.yml): `database` from inside its compose
# network (the dockerized Dagster services), `localhost` + port 5439 if
# running Dagster on the host. Password mirrors that compose's dev creds.
DAGSTER_PG_HOST=database
DAGSTER_PG_PASSWORD=password
