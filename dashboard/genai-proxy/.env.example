# The proxy needs no .env of its own: server.js auto-loads the repo-root .env
# (same convention as the pipelines and the webmap chat server) — put
# OPENROUTER_API_KEY there (see <repo-root>/.env.example). Shell/platform env
# vars always win over the file, so a deployed proxy uses real env vars.
#
# This file exists only for proxy-specific overrides. If you need them, copy it
# to .env (gitignored) and source it manually before starting:
#   set -a && source .env && set +a && node server.js

# GENAI_PROXY_PORT=8084
# GENAI_ALLOW_ORIGIN=http://localhost:3001
# GENAI_REFERER=https://philsa-poc.local/dashboard
